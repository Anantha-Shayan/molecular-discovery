# Company server:  cp .env.prod.example .env.prod   (git-ignored)   then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
TOOLS_HOST_DIR=/opt/molecular-tools
LICENSE_HOST_DIR=/etc/biosolveit
# Default is ro,z (relabels for SELinux, ignored elsewhere). Use plain ro to avoid relabelling /etc/biosolveit.
MOUNT_OPTS=ro
# 127.0.0.1 = only the server itself (use with the company reverse proxy); 0.0.0.0 = LAN
BIND_ADDRESS=127.0.0.1
PORT=8008
CPU_BUDGET=8
MAX_PARALLEL_BATCHES=2

# ChemAIRS SAScore API (commercial; optional — leave both blank to use the local RDKit SAscore instead).
# See ~/Desktop/APIInterfaceDocumentationEN.pdf and docs/DEPLOYMENT.md "ChemAIRS SAScore API" section.
# CHEMAIRS_BASE_URL=https://your-chemairs-domain.example.com
# CHEMAIRS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
