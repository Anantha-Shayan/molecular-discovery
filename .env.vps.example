# VPS:  cp .env.vps.example .env.vps   (git-ignored)   then:
#   docker compose -f docker-compose.yml -f docker-compose.vps.yml --env-file .env.vps up -d --build
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
# Name of the Docker network the proxy (Caddy) stack uses. Check with:  docker network ls
CADDY_NETWORK=n8n-stack_default
# Size these to the VPS (nproc / free -g). Docking is CPU-bound.
CPU_BUDGET=2
MAX_PARALLEL_BATCHES=1
APP_MEMORY_LIMIT=4g
LOG_LEVEL=INFO
