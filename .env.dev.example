# Local development:  cp .env.dev.example .env.dev   (git-ignored)   then:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d --build
POSTGRES_PASSWORD=dev-only-password
# Tools/licence default to ~/.local/share/molecular-tools and ~/.config/biosolveit — run ./scripts/install_tools.sh
# (override with TOOLS_HOST_DIR / LICENSE_HOST_DIR; they must point at UNPACKED executables, not the tarballs)
PORT=8008
CPU_BUDGET=8

# ChemAIRS SAScore API (commercial; optional — leave both blank to use the local RDKit SAscore instead).
# CHEMAIRS_BASE_URL=https://your-chemairs-domain.example.com
# CHEMAIRS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
