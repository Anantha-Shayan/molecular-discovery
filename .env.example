# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL (used by docker-compose.yml) -------------------------------
POSTGRES_DB=molecular_discovery
POSTGRES_USER=mdp
# REQUIRED. Use URL-safe characters only — it is embedded in DATABASE_URL.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Application -----------------------------------------------------------
# development | demo | production
#   development  SQLite fallback allowed, error detail shown, docs on
#   demo         PostgreSQL required, error detail hidden, docs on
#   production   PostgreSQL required, error detail hidden, docs off
APP_ENV=demo
LOG_LEVEL=INFO
# Port the app listens on and publishes.
PORT=8008
# Comma-separated origins allowed to call the API cross-origin. Leave empty:
# the UI is served by the app itself, so no CORS is needed.
CORS_ORIGINS=
# Upload size limit for structure files.
MAX_UPLOAD_MB=128
# Pause inside each MOCKED pipeline stage so progress is visible in a demo.
STAGE_DELAY_SECONDS=0.8

# --- Optional (defaults shown) --------------------------------------------
# ENABLE_API_DOCS=            # default: true except APP_ENV=production
# RUN_MIGRATIONS=true         # apply `alembic upgrade head` at container start
# DB_WAIT_TIMEOUT_SECONDS=60  # how long to wait for PostgreSQL at startup
# RCSB_TIMEOUT_SECONDS=15     # timeout when fetching a structure by PDB ID

# --- Running WITHOUT Docker (local development) ------------------------------
# Unset DATABASE_URL + APP_ENV=development uses ./data/app.db (SQLite).
# To develop against PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/molecular_discovery
# DATA_DIR=./data             # where runs/ and targets/ are written
